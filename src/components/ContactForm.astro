---
const web3formsKey = import.meta.env.WEB3FORMS_ACCESS_KEY || '373945b9-342f-46ea-b67e-990d75b2d3f9';
interface Props {
  subject: string;
  lang?: 'es' | 'en' | 'both';
}
const { subject, lang = 'both' } = Astro.props;
const isBoth = lang === 'both';
const onlyEs = lang === 'es';
const onlyEn = lang === 'en';
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="row">
    <label>
      {isBoth ? <span data-lang="es">Nombre</span> : null}
      {isBoth ? <span data-lang="en" hidden>Name</span> : null}
      {onlyEs ? 'Nombre' : null}
      {onlyEn ? 'Name' : null}
      <input name="name" autocomplete="name" required
        placeholder={onlyEn ? 'Your name' : 'Tu nombre'}
        data-placeholder-es="Tu nombre" data-placeholder-en="Your name" />
    </label>
    <label>Email<input name="email" type="email" autocomplete="email" required
      placeholder={onlyEn ? 'Your email' : 'Tu email'}
      data-placeholder-es="Tu email" data-placeholder-en="Your email" /></label>
  </div>
  <label>
    {isBoth ? <span data-lang="es">Empresa <small>(opcional)</small></span> : null}
    {isBoth ? <span data-lang="en" hidden>Company <small>(optional)</small></span> : null}
    {onlyEs ? 'Empresa (opcional)' : null}
    {onlyEn ? 'Company (optional)' : null}
    <input name="company" autocomplete="organization"
      placeholder={onlyEn ? 'Your company' : 'Tu empresa'}
      data-placeholder-es="Tu empresa" data-placeholder-en="Your company" />
  </label>
  <label>
    {isBoth ? <span data-lang="es">Mensaje</span> : null}
    {isBoth ? <span data-lang="en" hidden>Message</span> : null}
    {onlyEs ? 'Mensaje' : null}
    {onlyEn ? 'Message' : null}
    <textarea name="message" rows="5" required
      placeholder={onlyEn ? 'Tell us what you need' : 'Contanos qué necesitás'}
      data-placeholder-es="Contanos qué necesitás" data-placeholder-en="Tell us what you need"></textarea>
  </label>
  <button class="action" type="submit">
    {isBoth ? <span data-lang="es">Enviar</span> : null}
    {isBoth ? <span data-lang="en" hidden>Send</span> : null}
    {onlyEs ? 'Enviar' : null}
    {onlyEn ? 'Send' : null}
    <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg>
  </button>
  <p class="status" aria-live="polite"></p>
</form>

<style>
  .contact-form{display:grid;gap:1.6rem}
  .contact-form .row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  .contact-form label{display:grid;gap:.6rem;color:#f5f3ed;font-size:.78rem;font-weight:800;letter-spacing:.04em}
  .contact-form label small{color:#aee8d7}
  .contact-form input,.contact-form textarea{width:100%;resize:vertical;border:0;border-bottom:1px solid #46606a;background:transparent;color:#f5f3ed;font:500 1rem/1.4 Manrope;padding:.8rem 0}
  .contact-form input::placeholder,.contact-form textarea::placeholder{color:#7a96a0;opacity:1}
  .contact-form input:focus,.contact-form textarea:focus{outline:0;border-color:#aee8d7}
  .contact-form input,.contact-form textarea{caret-color:#aee8d7}
  .contact-form input:hover,.contact-form textarea:hover{border-color:#77bbb5}
  .contact-form .status{min-height:1.4em;color:#aee8d7;font-size:.84rem}
  .contact-form .botcheck{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .contact-form .action{display:inline-flex;gap:.8rem;align-items:center;border:0;background:#f5f3ed;color:#102633;cursor:pointer;font:700 .9rem/1 Manrope,sans-serif;padding:1rem 1.25rem;text-decoration:none;transition:.2s ease}
  .contact-form .action:hover{background:#aee8d7;transform:translateY(-2px)}
  .contact-form .action:active{transform:translateY(0);background:#0a7172;color:#fff}
  .contact-form .action svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.75}
  @media(max-width:760px){
    .contact-form .row{grid-template-columns:1fr}
  }
</style>

<script is:inline>
  const form = document.querySelector('.contact-form');
  const status = form?.querySelector('.status');
  const lang = document.documentElement.lang || 'es';
  const copy = {
    es: { sending: 'Enviando…', success: 'Gracias. Te respondemos pronto.', error: 'Algo falló. Escribinos a contact@alitrio.com.' },
    en: { sending: 'Sending…', success: 'Thank you. We will get back to you soon.', error: 'Something went wrong. Email us at contact@alitrio.com.' }
  };
  form?.addEventListener('submit', async (event) => {
    if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; }
    event.preventDefault();
    status.textContent = copy[lang]?.sending || copy.es.sending;
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      const data = await res.json();
      if (data.success) { status.textContent = copy[lang]?.success || copy.es.success; form.reset(); } else { status.textContent = copy[lang]?.error || copy.es.error; }
    } catch { status.textContent = copy[lang]?.error || copy.es.error; }
  });
</script>
