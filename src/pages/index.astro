---
const contactEmail = 'contact@alitrio.com';
const web3formsKey = import.meta.env.WEB3FORMS_ACCESS_KEY || '373945b9-342f-46ea-b67e-990d75b2d3f9';
const siteUrl = 'https://alitrio.com';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Alitrio',
  description: 'Consultora de transformación organizacional con IA. Convierte empresas en AI Companies, área por área, con resultados medibles.',
  url: siteUrl,
  email: contactEmail,
  areaServed: ['LATAM', 'España', 'Europa'],
  knowsAbout: ['Inteligencia Artificial', 'Transformación organizacional', 'Implementación de IA', 'Automatización de procesos', 'Licenciamiento de IA'],
  slogan: 'Te transformamos en una AI Company.',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alitrio — Te transformamos en una AI Company | Consultora IA</title>
    <meta name="description" content="Alitrio transforma empresas en AI Companies, área por área. Programa de transformación con IA para compañías de hasta 300 empleados en LATAM. Resultados medibles." />
    <meta name="robots" content="index, follow, max-snippet:160, max-image-preview:large" />
    <meta name="author" content="Alitrio" />
    <meta name="theme-color" content="#102633" />
    <link rel="canonical" href={siteUrl} />
    <link rel="alternate" hreflang="es" href={siteUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}?lang=en`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="Alitrio — Te transformamos en una AI Company" />
    <meta property="og:description" content="Programa de transformación con IA para empresas. La IA deja de ser un add-on y se vuelve el centro de cada área." />
    <meta property="og:locale" content="es" />
    <meta property="og:locale:alternate" content="en" />
    <meta property="og:site_name" content="Alitrio" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alitrio — Te transformamos en una AI Company" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Alitrio — Te transformamos en una AI Company" />
    <meta name="twitter:description" content="Programa de transformación con IA para empresas. La IA deja de ser un add-on y se vuelve el centro de cada área." />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23102633'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%230b9292'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <!-- THESIS: Alitrio makes organizational AI adoption legible as a deliberate operating system, refusing the generic AI-consulting hero. OWN-WORLD: sunlit paper, deep ink, cobalt structure and mineral green signals; editorial typography, ruled process lines and open fields. STORY: a leader sees a practical path from current operations to AI-centered work, understands the services and starts a conversation. FIRST VIEWPORT: a restrained wordmark and language switch sit above an oversized statement; a transformation diagram occupies the opposing field and the CTA anchors the lower edge. FORM: user-pinned “Cambio estructurado”, grounded candidate; seed d8ab768f. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance. -->
    <a class="skip" href="#main" data-lang="es">Ir al contenido</a><a class="skip" href="#main" data-lang="en" hidden>Skip to content</a>
    <header>
      <a class="brand" href="#top" aria-label="Alitrio home">ALITRIO<span>.</span></a>
      <nav aria-label="Primary navigation"><a href="#services" data-lang="es">Qué hacemos</a><a href="#method" data-lang="es">Cómo trabajamos</a><a href="#contact" data-lang="es">Contacto</a><a href="#services" data-lang="en" hidden>What we do</a><a href="#method" data-lang="en" hidden>How we work</a><a href="#contact" data-lang="en" hidden>Contact</a></nav>
      <div class="switch" aria-label="Language selector"><button type="button" data-language="es" aria-pressed="true">ES</button><button type="button" data-language="en" aria-pressed="false">EN</button></div>
    </header>
    <main id="main">
      <section class="hero" id="top">
        <div>
          <h1 data-lang="es">Te transformamos en una <em>AI Company.</em></h1><h1 data-lang="en" hidden>We turn you into an <em>AI Company.</em></h1>
          <p class="summary" data-lang="es">La IA ya cambió las reglas. La hacemos parte de cómo trabaja cada área de tu empresa, con resultados que se ven.</p><p class="summary" data-lang="en" hidden>AI has changed the rules. We make it part of how every area of your company works, with visible results.</p>
          <a class="action" href="#contact" data-lang="es">Hablemos <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 2v11M4 9l4 4 4-4" /></svg></a><a class="action" href="#contact" data-lang="en" hidden>Let’s talk <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 2v11M4 9l4 4 4-4" /></svg></a>
        </div>
        <div class="map" data-lang="es" aria-label="Proceso de transformación"><span class="start">Hoy</span><span class="end">AI Company</span><i></i><b class="one">Operación</b><b class="two">Equipos</b><b class="three">Procesos</b><p>La IA no se suma.<br />Se vuelve central.</p></div>
        <div class="map" data-lang="en" hidden aria-label="Transformation process"><span class="start">Today</span><span class="end">AI Company</span><i></i><b class="one">Operations</b><b class="two">Teams</b><b class="three">Processes</b><p>AI is not an add-on.<br />It becomes central.</p></div>
      </section>
      <section class="section services" id="services">
        <div class="heading"><h2 data-lang="es">Una adopción que cambia cómo trabaja tu empresa.</h2><h2 data-lang="en" hidden>An adoption that changes how your company works.</h2><p data-lang="es">El Programa AI Company convierte la IA en parte de la operación, no en una herramienta aislada.</p><p data-lang="en" hidden>The AI Company Program makes AI part of your operation, not an isolated tool.</p></div>
        <div class="list">
          <article><h3 data-lang="es">Las herramientas correctas para tu empresa</h3><h3 data-lang="en" hidden>The right tools for your company</h3><p data-lang="es">Seleccionamos e implementamos las herramientas de IA que mejor encajan con tu operación. No forzamos un ecosistema: elegimos lo que funciona para vos.</p><p data-lang="en" hidden>We select and implement the AI tools that best fit your operation. No forced ecosystem — we choose what works for you.</p></article>
          <article><h3 data-lang="es">Un plan que no para tu operación</h3><h3 data-lang="en" hidden>A plan that doesn't stop your operation</h3><p data-lang="es">Diseñamos un plan de adopción por área, un paso a la vez. Tu empresa sigue trabajando mientras se transforma.</p><p data-lang="en" hidden>We design an adoption plan by area, one step at a time. Your company keeps running while it transforms.</p></article>
          <article><h3 data-lang="es">Sabemos qué transformar primero</h3><h3 data-lang="en" hidden>We know what to transform first</h3><p data-lang="es">Auditamos tu organización para encontrar dónde la IA genera más valor, en qué orden y con qué resultados.</p><p data-lang="en" hidden>We audit your organization to find where AI creates the most value, in what order, and with what results.</p></article>
          <article><h3 data-lang="es">Tu equipo aprende haciendo</h3><h3 data-lang="en" hidden>Your team learns by doing</h3><p data-lang="es">Sesiones prácticas por área, con casos reales. Tu equipo sale usando IA, no escuchando teoría.</p><p data-lang="en" hidden>Hands-on sessions by area, with real cases. Your team leaves using AI, not listening to theory.</p></article>
        </div>
      </section>
      <section class="method section" id="method"><div class="heading"><h2 data-lang="es">La transformación se construye con tu equipo.</h2><h2 data-lang="en" hidden>Transformation is built with your team.</h2></div><ol data-lang="es"><li><strong>Un paso a la vez.</strong> Cada paso construye sobre lo que tu equipo ya sabe. Sin saltos bruscos ni parálisis.</li><li><strong>Área por área, no todo a la vez.</strong> Transformamos un área a la vez. Tu empresa sigue operando mientras cambia.</li><li><strong>Acompañamiento real.</strong> Estamos con vos en cada paso de la implementación, no solo en las sesiones.</li><li><strong>Resultados que se ven.</strong> Cada área termina con flujos automatizados funcionando. No promesas: procesos reales.</li></ol><ol data-lang="en" hidden><li><strong>One step at a time.</strong> Each step builds on what your team already knows. No sudden leaps, no paralysis.</li><li><strong>Area by area, not all at once.</strong> We transform one area at a time. Your company keeps running while it changes.</li><li><strong>Real support.</strong> We're with you at every step of implementation, not just in sessions.</li><li><strong>Visible results.</strong> Every area ends with automated workflows running. Not promises: real processes.</li></ol></section>
      <section class="audience"><p data-lang="es">Para compañías de hasta 300 empleados.</p><p data-lang="en" hidden>For companies of up to 300 employees.</p><h2 data-lang="es">Si tu equipo trabaja con información, comunicaciones o procesos, la IA ya puede transformar cómo opera.</h2><h2 data-lang="en" hidden>If your teams work with information, communication or processes, AI can already transform how you operate.</h2></section>
      <section class="contact section" id="contact"><div class="contact-copy"><h2 data-lang="es">Hablemos.</h2><h2 data-lang="en" hidden>Let’s talk.</h2><p data-lang="es">Contanos en qué momento está tu organización. Empecemos por ahí.</p><p data-lang="en" hidden>Tell us where your organization is today. We’ll start there.</p></div><form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate><input type="hidden" name="access_key" value={web3formsKey} /><input type="hidden" name="subject" value="Consulta desde alitrio.com" /><input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="row"><label><span data-lang="es">Nombre</span><span data-lang="en" hidden>Name</span><input name="name" autocomplete="name" required placeholder="Tu nombre" data-placeholder-es="Tu nombre" data-placeholder-en="Your name" /></label><label>Email<input name="email" type="email" autocomplete="email" required placeholder="Tu email" data-placeholder-es="Tu email" data-placeholder-en="Your email" /></label></div><label><span data-lang="es">Empresa <small>(opcional)</small></span><span data-lang="en" hidden>Company <small>(optional)</small></span><input name="company" autocomplete="organization" placeholder="Tu empresa" data-placeholder-es="Tu empresa" data-placeholder-en="Your company" /></label><label><span data-lang="es">Mensaje</span><span data-lang="en" hidden>Message</span><textarea name="message" rows="5" required placeholder="Contanos qué necesitás" data-placeholder-es="Contanos qué necesitás" data-placeholder-en="Tell us what you need"></textarea></label><button class="action" type="submit"><span data-lang="es">Enviar</span><span data-lang="en" hidden>Send</span> <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></button><p class="status" aria-live="polite"></p></form></section>
    </main>
    <footer><a class="brand" href="#top">ALITRIO<span>.</span></a><p data-lang="es">Transformación organizacional con IA.</p><p data-lang="en" hidden>Organizational transformation with AI.</p></footer>
    <script>
      const nodes = document.querySelectorAll('[data-lang]'), buttons = document.querySelectorAll('[data-language]'), fields = document.querySelectorAll('[data-placeholder-es]'), form = document.querySelector('form'), status = document.querySelector('.status');
      const copy = { es: { title: 'Alitrio — Te transformamos en una AI Company | Consultora IA', description: 'Alitrio transforma empresas en AI Companies, área por área. Programa de transformación con IA para compañías de hasta 300 empleados en LATAM. Resultados medibles.', sending: 'Enviando…', success: 'Gracias. Te respondemos pronto.', error: 'Algo falló. Escribinos a contact@alitrio.com.' }, en: { title: 'Alitrio — We Turn You Into an AI Company | AI Consulting', description: 'Alitrio turns companies into AI Companies, one area at a time. AI transformation program for companies of up to 300 employees. Visible results.', sending: 'Sending…', success: 'Thank you. We will get back to you soon.', error: 'Something went wrong. Email us at contact@alitrio.com.' } };
      function setLanguage(lang) { document.documentElement.lang = lang; document.title = copy[lang].title; document.querySelector('meta[name="description"]')?.setAttribute('content', copy[lang].description); nodes.forEach((node) => node.hidden = node.dataset.lang !== lang); buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.language === lang))); fields.forEach((field) => field.placeholder = field.dataset[`placeholder${lang[0].toUpperCase()}${lang.slice(1)}`]); const url = new URL(location.href); lang === 'en' ? url.searchParams.set('lang', 'en') : url.searchParams.delete('lang'); history.replaceState({}, '', url); }
      setLanguage(new URLSearchParams(location.search).get('lang') === 'en' ? 'en' : 'es'); buttons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.language)));
      form?.addEventListener('submit', async (event) => { if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; } event.preventDefault(); const lang = document.documentElement.lang; status.textContent = copy[lang].sending; try { const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) }); const data = await res.json(); if (data.success) { status.textContent = copy[lang].success; form.reset(); } else { status.textContent = copy[lang].error; } } catch { status.textContent = copy[lang].error; } });
    </script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}:global([hidden]){display:none!important}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#f5f3ed;color:#102633;font-family:Manrope,system-ui,sans-serif}:global(::selection){background:#aee8d7;color:#102633}:global(:focus-visible){outline:3px solid #147e83;outline-offset:4px}:global(html){scrollbar-width:thin;scrollbar-color:#b8c2bd #f5f3ed}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:#f5f3ed}::-webkit-scrollbar-thumb{background:#b8c2bd;border:2px solid #f5f3ed}::-webkit-scrollbar-thumb:hover{background:#8ba19e}h1,h2,h3,p{margin-top:0}h1,h2,h3,.brand{font-family:'DM Sans',sans-serif}.action svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.75}.method ol{counter-reset:none}.method li{counter-increment:none}.method li::before{content:none;display:none}.skip{position:fixed;z-index:4;transform:translateY(-200%);top:1rem;left:1rem;background:#102633;color:#fff;padding:.8rem;text-decoration:none}.skip:focus{transform:translateY(0)}header,footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.5rem;max-width:1440px;margin:auto;padding:1.4rem clamp(1.25rem,4vw,4.5rem)}.brand{color:#102633;font-size:1.35rem;font-weight:800;letter-spacing:-.04em;text-decoration:none}.brand span{color:#0a7172}nav{display:flex;justify-content:center;gap:clamp(.8rem,2vw,2rem)}nav a{color:#46606a;font-size:.78rem;font-weight:700;text-decoration:none;transition:color .2s ease}nav a:hover{color:#102633}.switch{display:flex;padding:.2rem;border:1px solid #b8c2bd;border-radius:99px}.switch button{border:0;border-radius:99px;background:transparent;color:#46606a;font-weight:800;font-size:.7rem;padding:.45rem .6rem}.switch [aria-pressed=true]{background:#102633;color:#fff}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2.5rem,7vw,8rem);max-width:1440px;min-height:min(760px,calc(100vh - 5rem));margin:auto;padding:clamp(4.5rem,10vw,9rem) clamp(1.25rem,8vw,9rem);align-items:center}.overline{color:#147e83;font-weight:800;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase}.hero h1{max-width:10ch;font-size:clamp(3.35rem,6.8vw,5rem);font-weight:700;letter-spacing:-.04em;line-height:1;margin-bottom:2rem}.hero em{color:#0a7172;font-style:normal}.summary{margin-bottom:2.5rem}.summary,.contact-copy p{max-width:58ch;color:#46606a;line-height:1.7}.action{display:inline-flex;gap:.8rem;align-items:center;border:0;background:#102633;color:#fff;cursor:pointer;font:700 .9rem/1 Manrope,sans-serif;padding:1rem 1.25rem;text-decoration:none;transition:.2s ease}.action:hover{background:#147e83;transform:translateY(-2px)}.action:active{transform:translateY(0);background:#0a7172}.action:focus-visible{outline-offset:6px}.map{position:relative;min-height:395px;overflow:hidden;border-top:1px solid #8ba19e;border-bottom:1px solid #8ba19e}.map span{position:absolute;top:1rem;color:#46606a;font-size:.67rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.map .start{left:0}.map .end{right:0;color:#0a7172}.map i{position:absolute;top:50%;width:100%;border-top:1px dashed #8ba19e}.map b{position:absolute;display:grid;place-items:end start;background:#d9ebe2;padding:1rem;font-size:.75rem;letter-spacing:.04em;transition:transform .6s cubic-bezier(.16,1,.3,1)}.map .one{top:4.6rem;left:8%;width:42%;height:33%}.map .two{right:2%;bottom:4.8rem;width:58%;height:30%;background:#add8d5}.map .three{right:18%;top:31%;width:34%;height:36%;background:#77bbb5}.map:hover .one{transform:translate(1rem,-.5rem)}.map:hover .two{transform:translate(-.8rem,.7rem)}.map:hover .three{transform:translate(.6rem,-.8rem)}.map p{position:absolute;right:0;bottom:.8rem;font:700 clamp(1.1rem,2vw,1.55rem)/1.15 'DM Sans';letter-spacing:-.03em;text-align:right}.section{max-width:1440px;margin:auto;padding:clamp(5rem,11vw,10rem) clamp(1.25rem,8vw,9rem)}.heading{display:grid;grid-template-columns:1.1fr .65fr;gap:3rem;margin-bottom:clamp(3rem,6vw,5.5rem)}h2{max-width:15ch;font-size:clamp(2.1rem,4vw,3.5rem);line-height:1.05;letter-spacing:-.03em}.heading p{color:#46606a;line-height:1.7}.services{border-top:1px solid #b8c2bd}.list{border-top:1px solid #102633}.list article{display:grid;grid-template-columns:1fr .8fr;gap:2.5rem;border-bottom:1px solid #b8c2bd;padding:2rem 0;transition:.2s}.list article:hover{background:#e9ede7;padding-inline:1rem}.list h3{font-size:clamp(1.2rem,2vw,1.65rem);letter-spacing:-.025em;line-height:1.2;margin-bottom:.5rem}.list p{color:#46606a;line-height:1.6}.method{max-width:none;background:#e2e9e3}.method .heading{grid-template-columns:1fr}.method ol{display:grid;grid-template-columns:repeat(4,1fr);padding:0;list-style:none}.method li{border-top:1px solid #8ba19e;color:#46606a;counter-increment:step;font-size:.94rem;line-height:1.65;padding:1.5rem 1.5rem 0}.method ol{counter-reset:step}.method li::before{content:'0' counter(step);display:block;color:#0a7172;font-size:.72rem;font-weight:800;letter-spacing:.08em;margin-bottom:3rem}.method strong{color:#102633}.audience{background:#102633;color:#f5f3ed;padding:clamp(5rem,12vw,10rem) clamp(1.25rem,8vw,9rem)}.audience p{color:#aee8d7;font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:1.5rem}.audience h2{color:#f5f3ed;max-width:20ch}.contact{display:grid;grid-template-columns:.75fr 1fr;gap:clamp(3rem,9vw,10rem)}.contact h2{font-size:clamp(2.5rem,4.5vw,4rem);letter-spacing:-.03em;line-height:1.05}form{display:grid;gap:1.6rem}.row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}label{display:grid;gap:.6rem;color:#102633;font-size:.78rem;font-weight:800;letter-spacing:.04em}label small{color:#46606a}input,textarea{width:100%;resize:vertical;border:0;border-bottom:1px solid #8ba19e;background:transparent;color:#102633;font:500 1rem/1.4 Manrope;padding:.8rem 0}input::placeholder,textarea::placeholder{color:#55727c;opacity:1}input:focus,textarea:focus{outline:0;border-color:#0a7172}input,textarea{caret-color:#0a7172}input:hover,textarea:hover{border-color:#77bbb5}.status{min-height:1.4em;color:#46606a;font-size:.84rem}.botcheck{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}footer{border-top:1px solid #b8c2bd;color:#46606a;font-size:.78rem}footer p{margin:0}@media(max-width:760px){header{grid-template-columns:1fr auto}nav{display:none}.hero,.contact{grid-template-columns:1fr}.hero{min-height:auto}.map{min-height:320px}.heading{grid-template-columns:1fr}.list article{grid-template-columns:1fr;gap:.8rem}.method ol{grid-template-columns:1fr 1fr;gap:2rem 0}.row{grid-template-columns:1fr}footer{grid-template-columns:1fr;gap:.8rem}}@media(max-width:440px){.method ol{grid-template-columns:1fr}.method li::before{margin-bottom:1.5rem}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}*,*:before,*:after{transition-duration:.01ms!important;animation-duration:.01ms!important}}@media print{:global(body){background:#fff;font-size:11pt}.hero{min-height:auto;padding:2rem 0}.section{padding:2rem 0}.map,.switch,nav,.action svg{display:none}.audience{background:#fff;color:#000;border:1px solid #ccc}.audience h2{color:#000}.audience p{color:#333}a{color:#000;text-decoration:underline}}
  .method ol{counter-reset:none}.method li{counter-increment:none}.method li::before{content:none;display:none}
</style>
